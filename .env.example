# ============================================================
#  JARVIS – Konfiguration
#  Kopiere diese Datei nach ".env" und trage deine Werte ein.
#  Die Datei ".env" wird NIEMALS in Git gespeichert.
# ============================================================

# --- Zugang -------------------------------------------------
# Passwort für die Anmeldung in der JARVIS-Oberfläche (mind. 8 Zeichen).
JARVIS_PASSWORD=

# --- Server -------------------------------------------------
# 127.0.0.1 = nur dieser PC kann JARVIS öffnen (sicherste Einstellung).
# 0.0.0.0   = auch andere Geräte im Netzwerk (z. B. dein Handy) – erst später nötig.
HOST=127.0.0.1
PORT=3000

# --- KI-Anbieter --------------------------------------------
# Welcher Anbieter standardmäßig genutzt wird: anthropic | openai | gemini
AI_PROVIDER=anthropic

# Anthropic Claude (empfohlen für beste Antwortqualität)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Denktiefe: low | medium | high  (höher = gründlicher, aber langsamer/teurer)
ANTHROPIC_EFFORT=medium

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Google Gemini (optional, hat ein kostenloses Kontingent)
GEMINI_API_KEY=
# "gemini-flash-latest" zeigt automatisch auf das aktuelle Flash-Modell.
GEMINI_MODEL=gemini-flash-latest

# --- Gedächtnis & Kontext -----------------------------------
# Automatisch wichtige Informationen aus Gesprächen merken (true/false)
MEMORY_AUTO_EXTRACT=true
# Wie viel vom aktuellen Gespräch wörtlich mitgeschickt wird (Zeichen).
# Älteres wird automatisch zusammengefasst.
CONTEXT_MAX_CHARS=24000

# --- Technisches (normalerweise nicht ändern) ---------------
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
